+# ---------------------------------------------------------------------------
+# PLE host table: dense bf16 buffer, or the fp8 shards spilled to disk and
+# memory-mapped.
+#
+# The dense path allocates total_rows*head_dim*2 bytes of host RAM -- 51.2e9
+# params is 102 GB -- *after* the 128 fp8 shards have already been buffered
+# (another 51 GB), so its peak is ~154 GB. That is comfortable on a big host
+# and impossible on a small one (Kaggle's CPU container reports 33 GB total).
+# The spill path writes each fp8 shard to disk as it arrives and maps the file,
+# so resident memory is the working set of the rows actually gathered rather
+# than the whole table. Chosen automatically from MemAvailable; force it with
+# QWEN4EXP_PLE_SPILL=1 and redirect it with QWEN4EXP_PLE_SPILL_DIR.
+# ---------------------------------------------------------------------------
+_PLE_SPILL_DIR = "/tmp/qwen4exp_ple"
+
+
+def _mem_available_bytes():
+    import os
+    try:
+        with open("/proc/meminfo") as fh:
+            mi = dict(l.split(":", 1) for l in fh.read().splitlines())
+        return int(mi["MemAvailable"].split()[0]) * 1024
+    except Exception:
+        return None
+
+
+def _spill_wanted(dense_bytes, fp8_bytes):
+    """True when the dense path (fp8 buffered + bf16 table) would not fit."""
+    import os
+    forced = os.environ.get("QWEN4EXP_PLE_SPILL")
+    if forced is not None:
+        return forced.strip().lower() not in ("", "0", "false", "no")
+    avail = _mem_available_bytes()
+    if avail is None:
+        return False
+    return avail < (dense_bytes + fp8_bytes) * 1.10
+
+
+class _SpilledPLETable:
+    """Duck-types the dense host table: ``table[ids] -> bf16 rows``.
+
+    Backed by one fp8 file on disk, memory-mapped, so host RAM holds only the
+    rows actually gathered instead of the full n*2-byte bf16 table. The only
+    consumer is ``ngram.PLEHostTable``, which just subscripts the object
+    (``rows = table[ids_np.reshape(-1)]``), so no forward-pass change is needed.
+    """
+
+    def __init__(self, path, shape, scale):
+        import os
+        import numpy as _np
+        self.path = str(path)
+        self.shape = tuple(int(d) for d in shape)
+        self.scale = float(scale)
+        # Present the array-like surface callers and tests inspect; the rows
+        # returned by __getitem__ really are bf16 (the fp8 dequant target).
+        self.dtype = _np.dtype(ml_dtypes.bfloat16)   # str() -> 'bfloat16', as numpy
+        self.ndim = len(self.shape)
+        self._mm = _np.memmap(self.path, dtype=_np.uint8, mode="r",
+                              shape=self.shape)
+        try:  # random access: stop the kernel reading whole shards ahead
+            fd = os.open(self.path, os.O_RDONLY)
+            os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_RANDOM)
+            os.close(fd)
+        except Exception:
+            pass
+
+    def __len__(self):
+        return self.shape[0]
+
+    def __getitem__(self, ids):
+        import numpy as _np
+        raw = self._mm[ids]                       # fp8 bytes, (n, head_dim)
+        fp8 = raw.view(ml_dtypes.float8_e4m3fn)
+        return (fp8.astype(_np.float32) * self.scale).astype(ml_dtypes.bfloat16)
+
